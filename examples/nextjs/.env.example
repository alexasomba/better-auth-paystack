# Copy to .env.local for local Next.js dev

# Paystack secret key (server-side)
PAYSTACK_SECRET_KEY=sk_test_...

# Paystack webhook signing secret.
# Paystack computes `x-paystack-signature` using your Paystack SECRET KEY.
# So this is optional and can be set to the same value as PAYSTACK_SECRET_KEY.
# PAYSTACK_WEBHOOK_SECRET=sk_test_...

# Optional: create Paystack customer record during sign-up
# Set to 1/true to enable.
PAYSTACK_CREATE_CUSTOMER_ON_SIGNUP=0

# Optional: Better Auth base URL, otherwise derived from request origin
# BETTER_AUTH_BASE_URL=http://localhost:3000
