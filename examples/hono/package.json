{
  "name": "hono",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "typecheck": "tsc6 -p tsconfig.json --noEmit",
    "check": "vp -C ../.. check examples/hono",
    "test": "vp test run --config ./vitest.config.ts"
  },
  "dependencies": {
    "@alexasomba/paystack-node": "catalog:",
    "better-auth": "catalog:",
    "better-auth-paystack": "workspace:*",
    "hono": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "catalog:"
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "packageManager": "pnpm@12.11.2"
}
